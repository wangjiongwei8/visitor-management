# ============================================
# 访客管理系统 V2 — 环境变量模板
# 复制为 .env.local（开发）或 .env.production（生产）后填写
# ============================================

# ===== 应用运行必需 =====

# PostgreSQL 连接串（应用直接读取 DATABASE_URL）
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>
DATABASE_URL=postgresql://postgres:password@localhost:5432/visitor_management

# Token 签名密钥（生产环境必须设置为长随机字符串，切勿使用默认值）
# 生成示例：openssl rand -hex 32
TOKEN_SECRET=replace-with-a-long-random-string-at-least-32-chars

# 运行环境：development | production
NODE_ENV=production

# ===== Docker 部署相关（仅 docker compose 构建镜像时使用）=====

# 数据库密码（同时用于 DATABASE_URL 与 postgres 容器）
DB_PASSWORD=password

# Docker Hub 用户名（推送镜像用）
DOCKER_USERNAME=your-dockerhub-username

# 镜像版本标签
VERSION=latest
